# Supabase Auth sits beside V2 and stays off unless this flag is the string true.
# The anon key is the only key allowed in the browser.
# Do not put a service credential, database password, or access token here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_AUTH_ENABLED=false
